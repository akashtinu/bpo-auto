(function(){function initForm(form){var btn=form.querySelector('.bpoef-btn');var btnText=form.querySelector('.bpoef-btn-text');var box=form.querySelector('.bpoef-response');var msgEl=form.querySelector('textarea[name="message"]');var countEl=form.querySelector('.bpoef-count');var fields={name:{el:form.querySelector('[name="name"]'),ok:function(v){return v.length>=2;}},email:{el:form.querySelector('[name="email"]'),ok:function(v){return/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v);}},phone:{el:form.querySelector('[name="phone"]'),ok:function(v){return/^[0-9+\-\s().]{6,}$/.test(v);}},message:{el:form.querySelector('[name="message"]'),ok:function(v){return v.length>=5;}}};if(msgEl&&countEl){msgEl.addEventListener('input',function(){countEl.textContent=msgEl.value.length;});}
function fieldError(key,on){fields[key].el.classList.toggle('bpoef-error',on);var msg=form.querySelector('.bpoef-err-msg[data-for="'+key+'"]');if(msg)msg.classList.toggle('show',on);}
function validate(){var ok=true;Object.keys(fields).forEach(function(key){var bad=!fields[key].ok(fields[key].el.value.trim());fieldError(key,bad);if(bad)ok=false;});return ok;}
Object.keys(fields).forEach(function(key){fields[key].el.addEventListener('input',function(){fieldError(key,false);});});function show(type,msg){box.className='bpoef-response '+type;box.textContent=msg;}
form.addEventListener('submit',function(e){e.preventDefault();box.className='bpoef-response';box.textContent='';if(!validate())return;btn.disabled=true;form.classList.add('bpoef-sending');btnText.textContent='Sending';var data=new FormData(form);data.append('action','bpoef_submit');fetch(BPOEF.ajax_url,{method:'POST',body:data,credentials:'same-origin'}).then(function(r){return r.json();}).then(function(res){if(res.success){form.reset();if(countEl)countEl.textContent='0';show('success',res.data.message);}else{show('error',(res.data&&res.data.message)||'Something went wrong. Please try again.');}}).catch(function(){show('error','Network error. Please try again.');}).finally(function(){btn.disabled=false;form.classList.remove('bpoef-sending');btnText.textContent='Enquiry';});});}
document.addEventListener('DOMContentLoaded',function(){document.querySelectorAll('.bpoef-form').forEach(initForm);});})();